---
import "../shared/theme.css";
import BrandMark from "../components/BrandMark.astro";
interface Props {
  title: string;
}

const { title } = Astro.props;
const SOURCE_CODE_URL = "https://github.com/kvojps/brazil-cancer-map";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href="/fonts/InterVariable-subset.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script is:inline>
      const theme = new URLSearchParams(location.search).get('theme');
      if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
    </script>
    <!-- The explicit theme needs JavaScript; without it the site follows the system preference. -->
    <noscript><style>.site-header .theme-switcher, .site-menu [data-theme-toggle] { display: none !important; }</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ir para o conteúdo</a>
    <!-- Under-construction notice, not dismissible (spec, section 2; decision ticket 29).
         Inverted neutrals keep it apart from the trend palette and from red. -->
    <aside class="construction-notice" aria-label="Aviso">
      <p>
        <strong>Em construção.</strong> Este site ainda está sendo desenvolvido e os números não
        passaram por uma validação completa: podem conter erros e mudar.
      </p>
    </aside>
    <header class="site-header">
      <details class="site-menu">
        <summary aria-label="Menu"><span aria-hidden="true">☰</span></summary>
        <nav aria-label="Menu">
          <a href="/">Mapa</a>
          <a href="/municipios/">Municípios por UF</a>
          <a href="/metodologia/">Como calculamos</a>
          <!-- On a phone the map screen does not reach the footer and the header has no room for the theme. -->
          <a class="menu-phone-only" href="/metodologia/#dados-e-fontes">Fontes e condições de reutilização</a>
          <a class="menu-phone-only" href={SOURCE_CODE_URL}>Código-fonte</a>
          <a class="menu-phone-only" href="?theme=dark" data-theme-toggle data-theme-choice="dark" aria-label="Usar tema escuro"><span aria-hidden="true">☾</span>&nbsp;<span data-theme-label>Usar tema escuro</span></a>
        </nav>
      </details>
      <a class="identity" href="/"><BrandMark /> Observatório do Câncer no Brasil</a>
      <slot name="header-tools" />
      <nav aria-label="Navegação principal">
        <a href="/">Mapa</a>
        <a href="/municipios/" id={Astro.url.pathname === "/" || Astro.url.pathname.startsWith("/municipio/") ? "municipality-index-heading" : undefined}>Municípios por UF</a>
        <a href="/metodologia/">Como calculamos</a>
      </nav>
      <nav aria-label="Tema" class="theme-switcher">
        <a class="control-link" href="?theme=dark" data-theme-toggle data-theme-choice="dark" aria-label="Usar tema escuro"><span aria-hidden="true">☾</span></a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <strong><BrandMark /> Observatório do Câncer no Brasil</strong>
      <a href="/metodologia/#dados-e-fontes">Downloads, fontes e condições de reutilização</a>
      <p>
        <a href={SOURCE_CODE_URL}>Código-fonte</a> sob a licença AGPL-3.0-or-later.
        Textos sob CC BY-SA 4.0, com atribuição ao Observatório do Câncer no Brasil.
        Os dados seguem as condições de cada fonte.
        Fonte tipográfica Inter sob a <a href="/fonts/OFL.txt">SIL Open Font License</a>.
      </p>
    </footer>
  </body>
</html>

<style>
  .construction-notice {
    position: sticky;
    top: 0;
    z-index: 40;
    padding: .5rem 1rem;
    font-size: var(--text-14);
    line-height: 1.4;
    color: var(--notice-text);
    background: var(--notice-bg);
    overflow-wrap: break-word;
  }
  .construction-notice p {
    margin: 0;
  }
  @media (min-width: 768px) {
    /* The height the desktop decision measured the map against; longer text still grows it. */
    .construction-notice { display: grid; align-items: center; min-height: 43px; }
  }
</style>

<script>
  import { mountSharedNavigation } from '../shared/navigation';
  mountSharedNavigation();
</script>
