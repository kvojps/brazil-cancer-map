---
import EstimatedCasesCard from './EstimatedCasesCard.astro';
import TreatmentCard from './TreatmentCard.astro';
import HpvCard from './HpvCard.astro';
import MortalityCard from './MortalityCard.astro';
import ScreeningCard from './ScreeningCard.astro';
import WhereToTreat from './WhereToTreat.astro';
import listing from '../../public/dados/municipalities.json';
import manifest from '../../public/dados/manifest.json';
import { ALL_CANCERS_NOTE, CANCER_TYPES } from '../map/indicator-layer';
import { type UfProfile } from '../profile/profile';

interface Props {
  municipality: typeof listing.municipalities[number];
  profile: UfProfile;
}
const { municipality, profile } = Astro.props;
const regions: Record<string, string> = listing.immediate_regions;
const sources: Record<string, { extracted_at: string }> = manifest.sources;
---
  <div class="profile" data-code={municipality.code}>
    <nav><a href="/" data-close-profile>Voltar ao mapa do Brasil</a></nav>
    <h2 tabindex="-1" data-profile-heading>{municipality.name} <small>({municipality.uf})</small></h2>
    <p>Meu município — dados sobre o cuidado com o câncer, para entender e agir.</p>
    <p>{ALL_CANCERS_NOTE}</p>
    <section id="acesso"><h2>Acesso ao tratamento</h2>
      {Object.entries(CANCER_TYPES).map(([cancerType, label]) => <section data-cancer-type={cancerType}>
        <h3>{label}</h3>
        <TreatmentCard treatment={profile.indicators.within_60_days[cancerType]!} code={municipality.code} cancerType={cancerType} regionName={regions[municipality.immediate_region] ?? municipality.immediate_region} updatedAt={manifest.sources.painel.extracted_at} />
      </section>)}
      <WhereToTreat services={profile.where_to_treat} code={municipality.code} />
    </section>
    <section id="deteccao"><h2>Detecção precoce</h2>
      {['all', 'breast'].map(cancerType => <section data-cancer-type={cancerType}>
        <ScreeningCard indicator="mammography" data={profile.indicators.mammography?.[cancerType]} code={municipality.code} cancerType={cancerType} regionName={regions[municipality.immediate_region] ?? municipality.immediate_region} updatedAt={sources.siscan?.extracted_at} />
      </section>)}
      {['all', 'cervix'].map(cancerType => <section data-cancer-type={cancerType}>
        <ScreeningCard indicator="cytopathology" data={profile.indicators.cytopathology?.[cancerType]} code={municipality.code} cancerType={cancerType} regionName={regions[municipality.immediate_region] ?? municipality.immediate_region} updatedAt={sources.siscan_cytopathology?.extracted_at} />
      </section>)}
    </section>
    <section id="prevencao"><h2>Prevenção</h2>
      {['all', 'cervix'].map(cancerType => <section data-cancer-type={cancerType}>
        <HpvCard data={profile.indicators.hpv?.[cancerType]} code={municipality.code} cancerType={cancerType} regionName={regions[municipality.immediate_region] ?? municipality.immediate_region} updatedAt={sources.hpv?.extracted_at} />
      </section>)}
    </section>
    <section><h2>Panorama</h2>
      {Object.entries(CANCER_TYPES).map(([cancerType, label]) => <section data-cancer-type={cancerType}>
        <h3>{label}</h3>
        <EstimatedCasesCard data={profile.indicators.estimated_cases?.[cancerType]} uf={municipality.uf} cancerType={cancerType} />
        <MortalityCard data={profile.indicators.mortality?.[cancerType]} code={municipality.code} cancerType={cancerType} regionName={regions[municipality.immediate_region] ?? municipality.immediate_region} updatedAt={sources.sim?.extracted_at} />
      </section>)}
    </section>
    <p><a href={`/dados/profiles/${municipality.uf}.json`}>Baixar os dados da ficha da UF</a> · <a href="/metodologia/">Como calculamos</a></p>
  </div>
