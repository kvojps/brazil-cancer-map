---
import { MAMMOGRAPHY_AGES, CYTOPATHOLOGY_TRANSITION, SCREENING_SCOPE } from '../content/indicator-notes';
import type { ScreeningProfile } from '../profile/profile';
import { formatIndicatorValue, originText, statusText, TREND_LABELS } from '../map/indicator-layer';
import { mammographyAction, cervicalScreeningAction } from '../content/actions';
interface Props { data?: ScreeningProfile; code: string; regionName: string; cancerType: string; updatedAt?: string; indicator: 'mammography' | 'cytopathology' }
const { data, code, regionName, cancerType, updatedAt, indicator } = Astro.props;
const cervical = indicator === 'cytopathology';
const action = cervical ? cervicalScreeningAction : mammographyAction;
const title = cervical ? 'Citopatológicos em mulheres de 25–64 anos' : 'Mamografias de rastreamento em mulheres de 50–69 anos';
const chartLabel = cervical ? 'citopatológicos' : 'mamografias de rastreamento';
const methodology = cervical ? 'citopatologico' : 'mamografia';
const entry = data?.municipalities[code];
const series = entry?.series_id ? data!.series[entry.series_id]! : [];
const valueText = (value: number | null) => formatIndicatorValue(indicator, value);
const chartTitle = `${indicator}-series-${cancerType}`;
const maximum = Math.max(1, ...series.map(point => point.value ?? 0));
const pointX = (year: number) => 42 + 500 * (year - 2016) / 9;
const pointY = (value: number) => 160 - 130 * value / maximum;
---
<article class="treatment-card" aria-label={cervical ? 'Citopatológicos — 25–64 anos' : 'Mamografias de rastreamento — 50–69 anos'}>
  <h3>{title}</h3>
  {cervical ? <>
    <p><strong>{CYTOPATHOLOGY_TRANSITION}</strong></p>
  </> : <p>{MAMMOGRAPHY_AGES}</p>}
  {data && entry ? <>
    <p><strong>Período dos dados: {data.period.first_year}–{data.period.last_year}. Último ano consolidado: {data.period.latest}.</strong></p>
    <p>{originText(entry, regionName)}</p>
    {entry.origin === 'immediate_region' && <p>Há poucos exames no município; usamos os dados do seu município e vizinhos.</p>}
    {entry.origin === 'insufficient' ? <>
      <p>Poucos exames aqui e na região para calcular o indicador. Isso é comum em municípios pequenos.</p>
      <p>Tendência no seu estado: <strong>{TREND_LABELS[data.uf_trend ?? 'insufficient']}</strong> ({data.period.trend.join('–')}).</p>
    </> : <>
      <h4>Situação em {data.period.latest}</h4>
      <p><strong>Razão {valueText(entry.value)}</strong> — {statusText(entry, data)}.</p>
      {entry.value !== null && <meter min="0" max="1" value={entry.value} aria-label={`Razão de ${chartLabel} em relação à meta 1`} />}
      {entry.status_note && <p>{entry.status_note}</p>}
      <p>Referência: razão 1 — meta. Comparamos o número anual de exames com {cervical ? 'um terço das mulheres de 25–64 anos' : 'a metade das mulheres de 50–69 anos'}.</p>
      <h4>Tendência ({data.period.trend.join('–')})</h4>
      <p><strong>{TREND_LABELS[entry.trend ?? 'insufficient']}</strong></p>
      {entry.trend === 'stable' && <p>Quase não mudou, menos de 1% por ano em relação ao próprio valor.</p>}
      {entry.trend === 'no_clear_direction' && <p>Pode ter subido ou caído; os dados não bastam para dizer.</p>}
      {entry.trend === 'improving' && <p>A razão de {chartLabel} aumentou.</p>}
      {entry.trend === 'worsening' && <p>A razão de {chartLabel} diminuiu.</p>}
      <svg viewBox="0 0 570 200" role="img" aria-labelledby={chartTitle}>
        <title id={chartTitle}>Razão anual de {chartLabel}; valores na tabela abaixo.</title>
        <line x1="42" x2="542" y1="160" y2="160" stroke="#80868f" />
        <text x="0" y="160">0</text><text x="0" y="30">{valueText(maximum)}</text>
        {series.map((point, index) => {
          const previous = series[index - 1];
          return <>
            {previous?.value != null && point.value !== null && <line x1={pointX(previous.year)} y1={pointY(previous.value)} x2={pointX(point.year)} y2={pointY(point.value)} stroke="#315e90" stroke-width="2" stroke-dasharray={point.provisional || previous.provisional ? '6 4' : undefined} />}
            {point.value !== null && <circle cx={pointX(point.year)} cy={pointY(point.value)} r="3" fill="#315e90" />}
          </>;
        })}
        <text x="42" y="185">2016</text><text x="505" y="185">2025</text>
      </svg>
      <details><summary>Ver a série em tabela</summary><table>
        <caption>{title}</caption>
        <thead><tr><th scope="col">Ano</th><th scope="col">Razão</th></tr></thead>
        <tbody>{series.map(point => <tr><th scope="row">{point.year}{point.provisional ? ' (provisório)' : ''}</th><td>{valueText(point.value)}</td></tr>)}</tbody>
      </table></details>
    </>}
    {data.period.provisional.length > 0 && <p>Anos provisórios por uso da população do ano anterior: {data.period.provisional.join(', ')}. Não entram na Tendência.</p>}
    <p>Fonte: <a href={data.source.url}>{data.source.name}</a>. {data.source.conditions}</p>
    {updatedAt && <p>Data de extração: <time datetime={updatedAt}>{updatedAt}</time>.</p>}
  </> : <p>Os dados de {chartLabel} ainda não estão disponíveis nesta ficha.</p>}
  <p>{SCREENING_SCOPE}</p>
  <section aria-label="Ação"><h4>{action.title}</h4><p>{action.summary}</p>
    {cervical && <p>{cervicalScreeningAction.transition}</p>}
    <details><summary>Saiba mais</summary>{action.reviewedVersion === action.version && action.reviewer && action.details.map(text => <p>{text}</p>)}
      <ul>{action.sources.map(source => <li><a href={source.url}>{source.title}</a></li>)}</ul>
    </details><p>{action.disclaimer}</p>
  </section>
  <p><a href={`/metodologia/#${methodology}`}>Como calculamos</a></p>
</article>
