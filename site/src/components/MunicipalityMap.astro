---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/dados`;
---

<div class="map-frame">
  <div
    class="map"
    data-mesh-url={`${base}/municipalities.topojson`}
    data-listing-url={`${base}/municipalities.json`}
    data-layers-url={`${base}/map/`}
    role="region"
    aria-label="Mapa do Brasil por município. Os mesmos dados estão na tabela abaixo do mapa."
  >
  </div>
  <p class="map-status" role="status">Carregando o mapa…</p>
</div>

<script>
  import { mountMunicipalityMap, mountIndicatorPaint } from "../map/municipality-map";
  import { mountMunicipalityNavigation } from "../map/navigation-view";
  import { mountIndicatorTable } from "../map/indicator-table";
  import { updateLegend } from '../map/legend';
  import {
    CANCER_TYPES,
    INDICATORS,
    mapOption,
    cancerTypeNotes,
    type IndicatorLayer,
    type MunicipalityListing,
  } from "../map/indicator-layer";

  import { normalizeMapState, readMapState, writeMapState, type MapState } from "../map/map-state";

  async function getJson<T>(url: string): Promise<T> {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`${url} request failed (${response.status})`);
    return response.json() as Promise<T>;
  }

  const container = document.querySelector<HTMLElement>(".map[data-mesh-url]");
  const status = document.querySelector<HTMLElement>(".map-status");
  const table = document.querySelector<HTMLElement>(".indicator-table");
  const selector = document.querySelector<HTMLSelectElement>("#cancer-type");
  const modeSelector = document.querySelector<HTMLSelectElement>("#map-mode");
  const notes = document.querySelector<HTMLElement>("#cancer-type-note");

  /** One request per cancer type: switching back reuses the layer already loaded. */
  const layers = new Map<string, Promise<IndicatorLayer>>();
  function layerOf(state: MapState): Promise<IndicatorLayer> {
    const key = `${state.indicator}/${state.cancerType}`;
    let layer = layers.get(key);
    if (!layer) {
      layer = getJson<IndicatorLayer>(`${container!.dataset.layersUrl}${key}.json`);
      layer.catch(() => layers.delete(key));
      layers.set(key, layer);
    }
    return layer;
  }

  function showNotes(layer: IndicatorLayer): void {
    if (!notes) return;
    notes.replaceChildren(
      ...cancerTypeNotes(layer).map((text) => {
        const note = document.createElement("p");
        note.textContent = text;
        return note;
      }),
    );
  }

  if (container && status) {
    const { meshUrl, listingUrl } = container.dataset;
    const initial = readMapState(new URLSearchParams(location.search));
    Promise.all([
      mountMunicipalityMap(container, meshUrl!),
      layerOf(initial),
      getJson<MunicipalityListing>(listingUrl!),
    ])
      .then(([map, layer, listing]) => {
        const showOnMap = mountIndicatorPaint(map, listing);
        const showInTable = table ? mountIndicatorTable(table, listing) : () => {};
        const notice = document.querySelector<HTMLElement>("#map-selection-notice");
        let updateProfileType = () => {};
        let current = initial;
        let request = 0;
        const syncControls = (state: MapState) => {
          if (selector) selector.value = state.cancerType;
          if (!modeSelector) return;
          for (const option of modeSelector.options) {
            const [id, mode] = option.value.split(":");
            const presentation = mapOption(id!, state.cancerType, mode as MapState["mode"]);
            const pending = option.dataset.pending === 'true';
            option.disabled = presentation.disabled || pending;
            option.textContent = presentation.label + (pending ? ' — dados ainda não disponíveis' : '');
          }
          modeSelector.value = `${state.indicator}:${state.mode}`;
        };
        const show = (shown: IndicatorLayer, state: MapState) => {
          current = state;
          syncControls(state);
          showOnMap(shown, state.mode);
          updateLegend(document.querySelector<HTMLElement>('.legend')!, shown, state.mode);
          showNotes(shown);
          const url = new URL(location.href);
          url.search = writeMapState(state, url.searchParams).toString();
          history.replaceState(null, "", url);
          showInTable(shown);
          updateProfileType();
        };
        const selectState = async (next: MapState, message = "") => {
          const pending = ++request;
          status.textContent = "Carregando o mapa…";
          status.hidden = false;
          if (notice) notice.hidden = true;
          try {
            const nextLayer = await layerOf(next);
            if (pending !== request) return;
            show(nextLayer, next);
            status.hidden = true;
            if (notice) {
              notice.textContent = message;
              notice.hidden = !message;
            }
          } catch (error) {
            if (pending !== request) return;
            console.error(error);
            syncControls(current);
            status.textContent = "Não foi possível carregar esta seleção. Tente de novo.";
          }
        };
        show(layer, initial);
        updateProfileType = mountMunicipalityNavigation(map, listing, listingUrl!.replace(/\/municipalities.json$/, ""));
        status.hidden = true;
        if (modeSelector) {
          modeSelector.disabled = false;
          modeSelector.addEventListener("change", () => {
            const [indicator, mode] = modeSelector.value.split(":");
            void selectState(normalizeMapState({ indicator, mode, cancerType: selector?.value ?? current.cancerType }));
          });
        }
        if (selector) {
          selector.disabled = false;
          selector.addEventListener("change", () => {
            const [indicator, mode] = modeSelector?.value.split(":") ?? [current.indicator, current.mode];
            const next = normalizeMapState({ indicator, mode, cancerType: selector.value });
            const message = next.indicator !== indicator
              ? `${INDICATORS[indicator!]?.name} não se aplica a ${CANCER_TYPES[next.cancerType]}; mostrando até 60 dias.` : "";
            void selectState(next, message);
          });
        }
        window.addEventListener("popstate", () => {
          void selectState(readMapState(new URLSearchParams(location.search)));
        });
      })
      .catch((error: unknown) => {
        console.error(error);
        status.textContent = "Não foi possível carregar o mapa. Tente recarregar a página.";
      });
  }
</script>

<style>
  .map-frame {
    position: relative;
    flex: 1;
    min-height: 60vh;
  }
  .map {
    position: absolute;
    inset: 0;
  }
  .map-status {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
  }
  .map :global(.map-tooltip) {
    display: grid;
    gap: 0.2rem;
    font: 0.8125rem/1.35 system-ui, sans-serif;
  }
</style>
