---
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/dados`;
---

<div class="map-frame">
  <div
    class="map"
    data-mesh-url={`${base}/municipalities.topojson`}
    data-listing-url={`${base}/municipalities.json`}
    data-layers-url={`${base}/map/`}
    role="region"
    aria-label="Mapa do Brasil por município. Os mesmos dados estão disponíveis na visualização Lista."
  >
  </div>
  <p class="map-status" role="status">Carregando o mapa…</p>
  <noscript>
    <p class="map-status map-no-script">O mapa e os filtros precisam de JavaScript. <a href="/municipios/">Consulte os municípios por UF</a>.</p>
    <style>.map-status:not(.map-no-script), .data-feedback { display: none; }</style>
  </noscript>
</div>

<script>
  import '../map/experience';
</script>

<style>
  .map-frame {
    position: relative;
    flex: 1;
    min-height: 60vh;
  }
  .map {
    position: absolute;
    inset: 0;
  }
  .map-status {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
  }
  .map-no-script {
    width: max-content;
    max-width: 90%;
  }
  @media (min-width: 768px) {
    .map-frame { height: 100%; min-height: 0; }
  }
  .map :global(.map-tooltip) {
    display: grid;
    gap: .25rem;
    font-size: var(--text-14);
    line-height: 1.4;
  }
</style>
