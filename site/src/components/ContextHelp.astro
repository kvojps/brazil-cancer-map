---
interface Props { id: string; label: string; icon?: boolean; }
const { id, label, icon = false } = Astro.props;
---
<button type="button" class="help-trigger" popovertarget={id} aria-describedby={`${id}-description`} aria-label={icon ? label : undefined} data-hover-help={icon || undefined}>{icon ? "ⓘ" : label}</button>
<div id={id} class="help-popover" popover>
  <div id={`${id}-description`}><slot /></div>
  {!icon && <button type="button" popovertarget={id} popovertargetaction="hide">Fechar ajuda</button>}
</div>
<style>
  /* Reads as a legend or field label, not as a filled control; the touch size stays. */
  .help-trigger, .help-trigger:hover:not(:disabled) { min-height: 1.5rem; padding: 0 .25rem; font-size: var(--text-14); color: var(--text); background: transparent; text-align: left; text-decoration: underline 1px var(--muted); text-underline-offset: .18em; }
  .help-trigger[data-hover-help], .help-trigger[data-hover-help]:hover:not(:disabled) { color: var(--muted); text-decoration: none; }
  @media (max-width: 767px) {
    .help-trigger, .help-trigger:hover:not(:disabled) { min-height: var(--control-height); }
  }
  .help-popover { max-width: min(32rem, calc(100vw - 2rem)); max-height: 80vh; overflow: auto; padding: 1rem; font-size: var(--text-14); background: var(--surface); color: var(--text); border: 0; border-radius: var(--card-radius); box-shadow: var(--card-shadow); }
  .help-popover::backdrop { background: #0003; }
  .help-popover > button { margin-top: .75rem; }
</style>

<script>
  for (const trigger of document.querySelectorAll<HTMLButtonElement>('[data-hover-help]')) {
    const popup = document.getElementById(trigger.getAttribute('popovertarget')!)!;
    let timer: ReturnType<typeof setTimeout>;
    let restoringFocus = false;
    const cancel = () => clearTimeout(timer);
    const open = () => {
      cancel();
      if (!popup.matches(':popover-open')) popup.showPopover();
      const rect = trigger.getBoundingClientRect();
      popup.style.margin = '0';
      popup.style.top = `${Math.max(8, Math.min(rect.bottom + 4, innerHeight - popup.offsetHeight - 8))}px`;
      popup.style.left = `${Math.max(8, Math.min(rect.left, innerWidth - popup.offsetWidth - 8))}px`;
    };
    const dismiss = () => {
      cancel();
      timer = setTimeout(() => {
        if (!popup.matches(':hover') && !trigger.matches(':hover') &&
            !popup.contains(document.activeElement) && document.activeElement !== trigger) popup.hidePopover();
      }, 180);
    };
    trigger.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') open(); });
    popup.addEventListener('beforetoggle', event => {
      if ((event as ToggleEvent).newState === 'closed') {
        restoringFocus = true;
        setTimeout(() => { restoringFocus = false; }, 0);
      }
    });
    trigger.addEventListener('focus', () => { if (!restoringFocus) open(); });
    trigger.addEventListener('click', event => { event.preventDefault(); open(); });
    for (const element of [trigger, popup]) {
      element.addEventListener('pointerleave', dismiss);
      element.addEventListener('focusout', dismiss);
      element.addEventListener('pointerenter', cancel);
    }
  }
</script>
