---
import listing from '../../public/dados/municipalities.json';
import { municipalityPath } from '../profile/profile';
const collator = new Intl.Collator('pt-BR');
const states = [...new Set(listing.municipalities.map(place => place.uf))].sort();
const names: Record<string, string> = {
  AC: 'Acre', AL: 'Alagoas', AP: 'Amapá', AM: 'Amazonas', BA: 'Bahia', CE: 'Ceará',
  DF: 'Distrito Federal', ES: 'Espírito Santo', GO: 'Goiás', MA: 'Maranhão',
  MT: 'Mato Grosso', MS: 'Mato Grosso do Sul', MG: 'Minas Gerais', PA: 'Pará',
  PB: 'Paraíba', PR: 'Paraná', PE: 'Pernambuco', PI: 'Piauí', RJ: 'Rio de Janeiro',
  RN: 'Rio Grande do Norte', RS: 'Rio Grande do Sul', RO: 'Rondônia', RR: 'Roraima',
  SC: 'Santa Catarina', SP: 'São Paulo', SE: 'Sergipe', TO: 'Tocantins',
};
---
<div class="municipality-index">
  {states.map(uf => {
    const places = listing.municipalities.filter(place => place.uf === uf).sort((a, b) => collator.compare(a.name, b.name));
    return <details id={`municipalities-${uf}`}>
      <summary><span class="state-code">{uf}</span><span class="state-name">{names[uf] ?? uf}<small>{places.length.toLocaleString('pt-BR')} {places.length === 1 ? 'município' : 'municípios'}</small></span></summary>
      <ul>{places.map(place => <li><a href={municipalityPath(place)}>{place.name}</a></li>)}</ul>
    </details>;
  })}
</div>
<style>
  .municipality-index { min-width: 0; display: grid; gap: .75rem; }
  details { border-radius: var(--card-radius); background: var(--surface); overflow-wrap: anywhere; scroll-margin-top: 1rem; }
  summary { cursor: pointer; padding: 1rem; }
  summary::marker { color: var(--muted); }
  .state-code { display: inline-block; padding: .25rem .5rem; margin-inline: .5rem .75rem; border-radius: var(--control-radius); background: var(--soft); color: var(--text); vertical-align: middle; font-size: var(--text-14); }
  .state-name { display: inline-block; vertical-align: middle; max-width: calc(100% - 5.5rem); }
  small { display: block; font-size: var(--text-12); font-weight: 400; color: var(--muted); margin-top: .25rem; }
  details[open] summary { border-bottom: 1px solid var(--border); }
  ul { list-style: none; padding: 1rem; margin: 0; columns: 15rem; column-gap: 2rem; }
  li { break-inside: avoid; }
  li a { display: block; padding: .5rem; border-radius: var(--control-radius); }
  li a:hover { background: var(--soft); }
  summary:hover { background: var(--soft); border-radius: var(--card-radius); }
</style>
