---
import listing from '../../public/dados/municipalities.json';
import { municipalityPath } from '../profile/profile';
const collator = new Intl.Collator('pt-BR');
const states = [...new Set(listing.municipalities.map(place => place.uf))].sort();
const names: Record<string, string> = {
  AC: 'Acre', AL: 'Alagoas', AP: 'Amapá', AM: 'Amazonas', BA: 'Bahia', CE: 'Ceará',
  DF: 'Distrito Federal', ES: 'Espírito Santo', GO: 'Goiás', MA: 'Maranhão',
  MT: 'Mato Grosso', MS: 'Mato Grosso do Sul', MG: 'Minas Gerais', PA: 'Pará',
  PB: 'Paraíba', PR: 'Paraná', PE: 'Pernambuco', PI: 'Piauí', RJ: 'Rio de Janeiro',
  RN: 'Rio Grande do Norte', RS: 'Rio Grande do Sul', RO: 'Rondônia', RR: 'Roraima',
  SC: 'Santa Catarina', SP: 'São Paulo', SE: 'Sergipe', TO: 'Tocantins',
};
---
<div class="municipality-index">
  {states.map(uf => {
    const places = listing.municipalities.filter(place => place.uf === uf).sort((a, b) => collator.compare(a.name, b.name));
    return <details id={`municipalities-${uf}`}>
      <summary><span class="state-code">{uf}</span> <span class="state-name"><span>{names[uf] ?? uf}</span> <small>{places.length.toLocaleString('pt-BR')} {places.length === 1 ? 'município' : 'municípios'}</small></span><span class="state-chevron" aria-hidden="true">⌄</span></summary>
      <ul>{places.map(place => <li><a href={municipalityPath(place)}>{place.name}</a></li>)}</ul>
    </details>;
  })}
</div>
<style>
  .municipality-index { min-width: 0; border-top: 1px solid var(--border); }
  details { border-bottom: 1px solid var(--border); overflow-wrap: anywhere; scroll-margin-top: 1rem; }
  summary { display: flex; align-items: center; gap: .75rem; min-height: 48px; padding: .5rem .25rem; font-weight: 500; list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--soft); }
  .state-code { flex: none; width: 2.5rem; font-weight: 600; }
  .state-name { display: flex; flex: 1; flex-wrap: wrap; justify-content: space-between; gap: 0 1rem; min-width: 0; }
  small { font-size: var(--text-14); font-weight: 400; color: var(--muted); }
  .state-chevron { flex: none; color: var(--muted); }
  details[open] .state-chevron { transform: rotate(180deg); }
  ul { list-style: none; padding: .25rem .25rem 1rem 3.5rem; margin: 0; columns: 14rem; column-gap: 2rem; }
  li { break-inside: avoid; }
  li a { display: flex; align-items: center; min-height: 44px; }
  @media (max-width: 480px) {
    ul { padding-left: .25rem; }
  }
</style>
