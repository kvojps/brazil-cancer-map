---
import listing from '../../public/dados/municipalities.json';
import { municipalityPath } from '../profile/profile';
const collator = new Intl.Collator('pt-BR');
const states = [...new Set(listing.municipalities.map(place => place.uf))].sort();
---
<details class="municipality-index">
  <summary>Consultar municípios por UF</summary>
  <h2 id="municipality-index-heading">Municípios por UF</h2>
  <p>Acesse Meu município mesmo sem mapa ou JavaScript.</p>
  <nav aria-label="Ir para uma UF">
    {states.map(uf => <a href={`#municipalities-${uf}`}>{uf}</a>)}
  </nav>
  {states.map(uf => <details id={`municipalities-${uf}`}>
    <summary>{uf}</summary>
    <ul>{listing.municipalities.filter(place => place.uf === uf).sort((a, b) => collator.compare(a.name, b.name)).map(place => <li><a href={municipalityPath(place)}>{place.name}</a></li>)}</ul>
  </details>)}
</details>
<style>
  .municipality-index { min-width: 0; overflow-wrap: anywhere; }
  nav { display: flex; flex-wrap: wrap; gap: .75rem; margin-block: 1rem; }
  summary { cursor: pointer; padding: .5rem; font-weight: 600; }
  ul { padding-inline-start: 1.5rem; }
  li { padding-block: .2rem; }
</style>
