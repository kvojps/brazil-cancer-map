---
// Text alternative populated independently of the optional map renderer.
---

<section id="indicator-table" class="indicator-table" aria-labelledby="list-heading" hidden>
  <h3 id="list-heading" tabindex="-1">Dados em lista</h3>
  <label>
    UF
    <select>
      <option value="">Todas as UFs</option>
    </select>
  </label>
  <p class="table-count" aria-live="polite">Carregando…</p>
      <p class="table-description" id="table-description">
        <span class="indicator-name"></span>.
        Modo: <span class="table-mode"></span>. Tipo de câncer: <span class="cancer-type"></span>. Indicador em cada
        município, Tendência quando disponível e valor do último ano consolidado (<span class="latest-year"></span>)<span
          class="measured-cases"
        ></span>. <span class="treatment-note">A % sem informação de tratamento é sobre todos os casos diagnosticados.</span>
        {" "}<span class="quality-note"></span>
        {" "}<span class="status-note"></span>
        {" "}<span class="reference-note"></span>
        {" "}Período da Tendência: <span class="trend-period"></span>.
      </p>
  <div class="scroll" tabindex="0" role="region" aria-label="Tabela dos municípios">
    <table aria-describedby="table-description">
      <caption>Valores, classes e origem por município</caption>
      <thead>
        <tr>
          <th scope="col">Município</th>
          <th scope="col">UF</th>
          <th scope="col">Tendência</th>
          <th scope="col">Situação</th>
          <th scope="col">Nota do valor</th>
          <th scope="col" class="value-heading">Em até 60 dias</th>
          <th scope="col" data-treatment-column>Sem informação de tratamento</th>
          <th scope="col">Origem do dado</th>
          <th scope="col" data-treatment-column>Qualidade do registro na UF</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</section>

<style>
  .indicator-table {
    padding: 1rem;
    min-width: 0;
    font-size: 0.875rem;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.25rem 0;
  }
  label {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0.5rem 0;
  }
  select {
    font: inherit;
  }
  .scroll {
    max-height: 60vh;
    overflow: auto;
  }
  .scroll:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 65rem;
  }
  caption {
    text-align: left;
    padding: 0.25rem 0;
  }
  /* Rows are built by the map island, outside Astro's scoped styles. */
  table :global(th),
  table :global(td) {
    text-align: left;
    padding: 0.25rem 0.5rem;
    border-bottom: 1px solid var(--border);
    overflow-wrap: normal;
  }
  thead th {
    position: sticky;
    top: 0;
    background: var(--surface);
  }
  tbody :global(th) {
    font-weight: normal;
  }
</style>
