---
// Text alternative populated independently of the optional map renderer.
---

<section id="indicator-table" class="indicator-table" aria-labelledby="list-heading" hidden>
  <h3 id="list-heading" class="visually-hidden">Dados em lista</h3>
  <div class="list-bar">
    <label>
      UF
      <select>
        <option value="">Todas as UFs</option>
      </select>
    </label>
    <p class="table-count" aria-live="polite">Carregando…</p>
  </div>
  <div class="list-notes">
    <p class="table-lede"></p>
    <details>
      <summary>Como ler esta lista</summary>
      <p class="table-description" id="table-description">
        <span class="indicator-name"></span>.
        Modo: <span class="table-mode"></span>. Tipo de câncer: <span class="cancer-type"></span>. Indicador em cada
        município, Tendência quando disponível e valor do último ano consolidado (<span class="latest-year"></span>)<span
          class="measured-cases"
        ></span>. <span class="treatment-note">A % sem informação de tratamento é sobre todos os casos diagnosticados.</span>
        {" "}<span class="quality-note"></span>
        {" "}<span class="status-note"></span>
        {" "}<span class="reference-note"></span>
        {" "}<span class="trend-period"></span>
      </p>
    </details>
  </div>
  <div class="scroll" tabindex="0" role="region" aria-label="Tabela dos municípios">
    <!-- Explicit roles: the narrow form lays these elements out as a grid, which would drop their table semantics. -->
    <table role="table" aria-describedby="table-description">
      <caption class="visually-hidden">Valores, classes e origem por município</caption>
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader" data-column="name">Município</th>
          <th scope="col" role="columnheader" data-column="uf">UF</th>
          <th scope="col" role="columnheader" data-column="trend">Tendência</th>
          <th scope="col" role="columnheader" data-column="status">Situação</th>
          <th scope="col" role="columnheader" data-column="note">Nota do valor</th>
          <th scope="col" role="columnheader" data-column="value" class="value-heading">Em até 60 dias</th>
          <th scope="col" role="columnheader" data-column="missing">Sem informação de tratamento</th>
          <th scope="col" role="columnheader" data-column="origin">Origem do dado</th>
          <th scope="col" role="columnheader" data-column="quality">Qualidade do registro na UF</th>
          <th scope="col" role="columnheader" data-column="more">Mais dados</th>
        </tr>
      </thead>
      <tbody role="rowgroup"></tbody>
    </table>
  </div>
</section>

<style>
  .indicator-table {
    container: list / inline-size;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    min-width: 0;
    font-size: var(--text-14);
    background: var(--surface);
  }
  .list-bar, .list-notes, .scroll { grid-column: 1 / -1; min-width: 0; }
  .list-bar {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .25rem .75rem;
    background: var(--surface);
  }
  /* One line, so what the fixed bar covers is known: the selector gives way first. */
  label {
    display: inline-flex;
    flex: 0 1 auto;
    gap: .5rem;
    align-items: center;
    min-width: 0;
    font-weight: 500;
    white-space: nowrap;
  }
  select { width: auto; min-width: 0; }
  .table-count { flex: none; margin: 0; font-weight: 500; white-space: nowrap; }
  /* The message of a failed load is a sentence: with no rows to cover, the bar can grow. */
  .list-bar:has(select:disabled) { flex-wrap: wrap; }
  .list-bar:has(select:disabled) .table-count { flex: 0 1 auto; white-space: normal; }
  .list-notes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1rem;
    padding: 0 .75rem;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .table-lede { margin: 0; }
  details[open] { flex-basis: 100%; }
  summary {
    display: flex;
    align-items: center;
    width: fit-content;
    min-height: 44px;
    font-weight: 500;
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: .18em;
    list-style: revert;
    cursor: pointer;
  }
  .table-description { max-width: 68ch; margin: 0 0 .5rem; }

  /* The wide form: a real table with its header and the municipality fixed. Rows are built by the map island,
     outside Astro's scoped styles. */
  table {
    width: 100%;
    min-width: 54rem;
    border-collapse: separate;
    border-spacing: 0;
  }
  table :global(th),
  table :global(td) {
    padding: .5rem .75rem;
    text-align: left;
    vertical-align: top;
    overflow-wrap: normal;
    border-bottom: 1px solid var(--border);
  }
  thead th {
    position: sticky;
    top: 0;
    z-index: 2;
    font-size: var(--text-12);
    font-weight: 500;
    color: var(--muted);
    vertical-align: bottom;
    background: var(--surface);
  }
  thead th:first-child { left: 0; z-index: 3; border-right: 1px solid var(--border); }
  tbody :global(th) {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 11rem;
    font-weight: 500;
    background: var(--surface);
    border-right: 1px solid var(--border);
  }
  table :global([data-column="value"]) { text-align: right; white-space: nowrap; }
  tbody :global(td[data-column="value"]) { font-weight: 600; }
  tbody :global(td[data-column="trend"]), tbody :global(td[data-column="status"]) { min-width: 9.5rem; }
  tbody :global(td[data-column="origin"]), tbody :global(td[data-column="quality"]) { min-width: 11rem; }
  table :global([data-column="more"]) { display: none; }
  tbody :global(.cell-label) { display: none; }
  tbody :global(.row-swatch) {
    display: inline-block;
    width: .875rem;
    height: .875rem;
    margin-right: .375rem;
    vertical-align: -.1em;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px var(--swatch-border);
  }
  tbody :global(.row-mark) {
    display: inline-block;
    padding: 0 .25rem;
    font-size: var(--text-12);
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    border: 1px solid var(--muted);
    border-radius: 4px;
  }
  /* Below 640 px of its own width, so also on a 768 px window with the panel open. */
  @container list (width < 640px) {
    table, tbody { display: block; min-width: 0; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    tbody :global(tr) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto 44px;
      align-items: center;
      column-gap: .5rem;
      padding: .375rem .25rem .375rem .75rem;
      border-bottom: 1px solid var(--border);
    }
    tbody :global(th), tbody :global(td) { display: none; min-width: 0; padding: 0; overflow-wrap: anywhere; border: 0; }
    tbody :global(th) { position: static; display: block; grid-area: 1 / 1; font-size: var(--text-16); }
    tbody :global(td[data-reading]) { display: block; grid-area: 2 / 1; font-size: var(--text-12); color: var(--muted); }
    tbody :global(td[data-column="value"]) { display: block; grid-area: 1 / 2 / 3 / 3; font-size: var(--text-20); white-space: normal; }
    tbody :global(td[data-column="more"]) { display: block; grid-area: 1 / 3 / 3 / 4; }
    tbody :global([data-row-toggle]), tbody :global([data-row-toggle]:hover:not(:disabled)) {
      display: grid;
      place-items: center;
      width: 44px;
      min-height: 44px;
      padding: 0;
      font-size: var(--text-16);
      color: var(--text);
      background: transparent;
    }
    tbody :global([data-row-toggle]:hover:not(:disabled)) { background: var(--soft); }
    tbody :global(tr[data-open] [data-row-toggle] span) { transform: rotate(180deg); }
    tbody :global(tr[data-open] td:not([data-reading], [data-column="value"], [data-column="more"], [data-empty])) {
      display: block;
      grid-column: 1 / -1;
      padding-block: .125rem;
      font-size: var(--text-12);
      color: var(--muted);
    }
    tbody :global(.cell-label) { display: inline; font-weight: 500; }
    tbody :global(.row-swatch) { margin-right: .25rem; }
    tbody :global(.value-unit) { display: block; font-size: var(--text-12); font-weight: 400; color: var(--muted); }
  }
  @container list (width >= 640px) {
    .list-bar { grid-area: 1 / 1; border-bottom: 1px solid var(--border); }
    .list-notes { grid-area: 1 / 2; justify-content: flex-end; }
    .scroll { overflow: auto; min-height: 16rem; max-height: calc(100dvh - var(--notice-height, 6rem) - 4rem); }
  }
  /* A phone holding the floating composition: only this line stays with the page scrolled, under the notice. */
  @media (max-width: 767px) and (min-width: 300px) and (min-height: 520px) {
    .list-bar { position: sticky; top: var(--notice-height, 6rem); z-index: 3; }
    :global(html:has(.indicator-table:not([hidden]))) { scroll-padding-block: calc(var(--notice-height, 6rem) + 3.5rem) calc(var(--sheet-height, 0px) + 5rem); }
  }
  /* From 768 px the list takes the map's area: its rows scroll inside and the bars stay in view. */
  @media (min-width: 768px) {
    .indicator-table { grid-template-rows: auto auto minmax(16rem, 1fr); height: 100%; overflow: auto; }
    .scroll { grid-row: 3; min-height: 0; max-height: none; overflow: auto; }
  }
</style>
