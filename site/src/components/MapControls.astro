---
import ContextHelp from './ContextHelp.astro';
import manifest from '../../public/dados/manifest.json';
import { CANCER_TYPES, DEFAULT_CANCER_TYPE, INDICATORS, cancerTypeNotes } from "../map/indicator-layer";

// Controls become available once their data is ready.
const hpvPending = !Object.hasOwn(manifest.indicators, 'hpv');
const notes = cancerTypeNotes({ cancer_type: DEFAULT_CANCER_TYPE, has_status: true });
---

<form class="map-controls" aria-label="O que o mapa mostra" onsubmit="return false">
  <label>
    Indicador
    <select id="map-indicator" disabled>
      {Object.entries(INDICATORS).map(([id, text]) => <option value={id} data-pending={id === "hpv" && hpvPending ? "true" : undefined} disabled={id === "hpv" && hpvPending}>{text.name}</option>)}
    </select>
  </label>
  <label>
    Leitura
    <select id="map-reading" disabled>
      <option value="trend">Tendência</option>
      <option value="status">Como está hoje</option>
    </select>
  </label>
  <div class="cancer-type">
    <div class="cancer-type-heading">
      <label for="cancer-type">Tipo de câncer</label>
      <ContextHelp id="cancer-help" label="Sobre o Tipo de câncer" icon>
        <div id="cancer-type-note" class="note" aria-live="polite">
          {notes.map((note) => <p>{note}</p>)}
        </div>
      </ContextHelp>
    </div>
    <select id="cancer-type" name="cancer-type" aria-describedby="cancer-help-description" disabled>
      {Object.entries(CANCER_TYPES).map(([value, label]) => (
        <option value={value} selected={value === DEFAULT_CANCER_TYPE}>{label}</option>
      ))}
    </select>
  </div>
  <nav class="view-controls" aria-label="Visualização" hidden>
    <button type="button" data-view="mapa" aria-pressed="true">Mapa</button>
    <button type="button" data-view="lista" aria-pressed="false">Lista</button>
  </nav>
  <div class="map-notes">
    <p id="indicator-caveat" class="note" role="status" hidden></p>
    <p id="map-selection-notice" class="note" role="status" hidden></p>
  </div>
  <a href="#preview-heading" class="preview-shortcut" data-preview-shortcut hidden>Ir para Meu município</a>
</form>

<script>
  document.querySelector('[data-preview-shortcut]')?.addEventListener('click', event => {
    const heading = document.getElementById('preview-heading');
    if (!heading) return;
    event.preventDefault();
    heading.focus({ preventScroll: true });
    heading.scrollIntoView({ block: 'start' });
  });
</script>

<style>
  .map-controls {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 1rem;
    align-items: start;
  }
  label,
  .cancer-type {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    font-size: var(--text-14);
    font-weight: 500;
    flex: 1 1 10rem;
  }
  .cancer-type label {
    flex: none;
  }
  /* One label height across the bar, so the ⓘ beside Tipo de câncer does not push its select down. */
  label { line-height: 1.5rem; }
  .cancer-type-heading { display: flex; align-items: center; gap: .25rem; }
  .cancer-type-heading label { display: block; }
  .view-controls { display: flex; gap: .25rem; align-self: end; }
  .view-controls button { min-width: 3.75rem; }
  .map-notes { flex-basis: 100%; }
  .map-notes:not(:has(p:not([hidden]))) { display: none; }
  .note {
    color: var(--muted);
    font-size: var(--text-14);
  }
  .map-notes p { margin: 0; }
  .note p {
    margin: 0;
  }
  .note p + p {
    margin-top: 0.25rem;
  }
  @media (min-width: 768px) {
    .map-controls { position: relative; z-index: 6; flex: none; align-items: center; gap: .5rem 1.25rem; min-height: 56px; padding: .25rem 1rem; background: var(--surface); border-bottom: 1px solid var(--border); }
    label, .cancer-type { flex: 0 1 auto; flex-direction: row; align-items: center; gap: .5rem; white-space: nowrap; }
    .cancer-type-heading { flex: none; }
    #map-indicator { width: 19rem; }
    #map-reading { width: 10rem; }
    #cancer-type { width: 11rem; }
    .view-controls { margin-left: auto; align-self: center; }
    /* Caveats hang under the bar, over the map's empty corner, so they never change the map's height.
       In the list view they enter the flow, where the rows would otherwise sit beneath them. */
    .map-notes { position: absolute; top: calc(100% + 1px); left: 0; max-width: min(18rem, calc(100% - 4rem)); padding: .5rem 1rem; background: var(--surface); border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); border-bottom-right-radius: var(--card-radius); }
    :global(.home:has(.indicator-table:not([hidden]))) .map-notes { position: static; max-width: none; padding: 0; border: 0; }
    :global(.home:has(#municipality-preview:not([hidden]))) .map-notes { max-width: min(18rem, calc(100% - var(--panel-width) - 4rem)); }
    /* A keyboard shortcut only: the panel is already beside the map, and the link must not reshape the bar. */
    .preview-shortcut { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .preview-shortcut:focus { top: 100%; right: 1rem; width: auto; height: auto; padding: .5rem .75rem; clip-path: none; background: var(--surface); }
  }
</style>
