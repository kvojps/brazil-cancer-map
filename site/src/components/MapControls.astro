---
import ContextHelp from './ContextHelp.astro';
import manifest from '../../public/dados/manifest.json';
import { CANCER_TYPES, DEFAULT_CANCER_TYPE, INDICATORS, cancerTypeNotes } from "../map/indicator-layer";
import { filterSummary, normalizeMapState } from "../map/map-state";

// Controls become available once their data is ready.
const hpvPending = !Object.hasOwn(manifest.indicators, 'hpv');
const notes = cancerTypeNotes({ cancer_type: DEFAULT_CANCER_TYPE, has_status: true });
---

<form class="map-controls" aria-label="O que o mapa mostra" onsubmit="return false">
  <!-- A native popover opens without JavaScript and, being manual, leaves the map in reach behind it. -->
  <button type="button" class="filters-toggle" popovertarget="map-filters">
    <strong>Filtros</strong>
    <span data-filter-summary>{filterSummary(normalizeMapState({}))}</span>
  </button>
  <div id="map-filters" class="filters-sheet" popover="manual">
  <label>
    Indicador
    <select id="map-indicator" disabled>
      {Object.entries(INDICATORS).map(([id, text]) => <option value={id} data-pending={id === "hpv" && hpvPending ? "true" : undefined} disabled={id === "hpv" && hpvPending}>{text.name}</option>)}
    </select>
  </label>
  <label>
    Leitura
    <select id="map-reading" disabled>
      <option value="trend">Tendência</option>
      <option value="status">Como está hoje</option>
    </select>
  </label>
  <div class="cancer-type">
    <div class="cancer-type-heading">
      <label for="cancer-type">Tipo de câncer</label>
      <ContextHelp id="cancer-help" label="Sobre o Tipo de câncer" icon>
        <div id="cancer-type-note" class="note" aria-live="polite">
          {notes.map((note) => <p>{note}</p>)}
        </div>
      </ContextHelp>
    </div>
    <select id="cancer-type" name="cancer-type" aria-describedby="cancer-help-description" disabled>
      {Object.entries(CANCER_TYPES).map(([value, label]) => (
        <option value={value} selected={value === DEFAULT_CANCER_TYPE}>{label}</option>
      ))}
    </select>
  </div>
  <noscript>
    <p class="filters-noscript">Os filtros mudam o mapa e precisam de JavaScript. <a href="/municipios/">Consulte os municípios por UF</a>.</p>
    <style>.filters-close { display: none !important; }</style>
  </noscript>
  <button type="button" class="filters-close" popovertarget="map-filters" popovertargetaction="hide">Ver mapa</button>
  </div>
  <nav class="view-controls" aria-label="Visualização" hidden>
    <button type="button" data-view="mapa" aria-pressed="true">Mapa</button>
    <button type="button" data-view="lista" aria-pressed="false">Lista</button>
  </nav>
  <div class="map-notes">
    <p id="indicator-caveat" class="note" role="status" hidden></p>
    <p id="map-selection-notice" class="note" role="status" hidden></p>
  </div>
</form>

<script>
  const sheet = document.querySelector<HTMLElement>('#map-filters');
  const closeSheet = () => { if (sheet?.matches(':popover-open')) sheet.hidePopover(); };
  // Unlike an auto popover, a manual one does not give focus back when it closes.
  sheet?.addEventListener('beforetoggle', event => {
    if ((event as ToggleEvent).newState === 'closed' && sheet.contains(document.activeElement)) document.querySelector<HTMLElement>('.filters-toggle')?.focus();
  });
  // A manual popover has no native Escape, and the sheet belongs to the floating composition only.
  document.addEventListener('keydown', event => { if (event.key === 'Escape') closeSheet(); });
  // A popover sits above everything else on the page, so it gives way to what opens from the header.
  document.querySelector('.site-menu')?.addEventListener('toggle', event => { if ((event.target as HTMLDetailsElement).open) closeSheet(); });
  document.querySelector('.search-toggle')?.addEventListener('click', closeSheet);
  matchMedia('(max-width: 767px) and (min-width: 300px) and (min-height: 520px)').addEventListener('change', closeSheet);
</script>

<style>
  .map-controls {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 1rem;
    align-items: start;
  }
  label,
  .cancer-type {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    font-size: var(--text-14);
    font-weight: 500;
    flex: 1 1 10rem;
  }
  .cancer-type label {
    flex: none;
  }
  /* One label height across the bar, so the ⓘ beside Tipo de câncer does not push its select down. */
  label { line-height: 1.5rem; }
  .cancer-type-heading { display: flex; align-items: center; gap: .25rem; }
  .cancer-type-heading label { display: block; }
  .view-controls { display: flex; gap: .25rem; align-self: end; }
  .view-controls button { min-width: 3.75rem; }
  .map-notes { flex-basis: 100%; }
  .map-notes:not(:has(p:not([hidden]))) { display: none; }
  .note {
    color: var(--muted);
    font-size: var(--text-14);
  }
  .map-notes p { margin: 0; }
  .note p {
    margin: 0;
  }
  .note p + p {
    margin-top: 0.25rem;
  }
  .filters-toggle, .filters-close, .filters-noscript { display: none; }
  /* From 768 px and in the in-flow composition the selectors are always in place, and the sheet does not exist. */
  @media (min-width: 768px), (max-width: 299px), (max-height: 519px) {
    .filters-sheet:not(:popover-open) { display: contents; }
  }
  @media (max-width: 767px) {
    .map-controls { position: relative; padding: .75rem; }
    .filters-sheet:popover-open { position: fixed; inset: auto 0 0; display: flex; flex-direction: column; gap: .5rem; width: 100%; max-width: none; max-height: 50dvh; margin: 0; padding: .75rem; overflow: auto; color: var(--text); background: var(--surface); border: 0; border-radius: var(--card-radius) var(--card-radius) 0 0; box-shadow: var(--card-shadow); }
    .filters-sheet:popover-open > label, .filters-sheet:popover-open > .cancer-type { flex: none; }
    .filters-sheet:popover-open .filters-close { position: sticky; bottom: 0; display: block; flex: none; }
    .filters-sheet:popover-open .filters-noscript { display: block; margin: 0; font-size: var(--text-14); }
    .cancer-type-heading { justify-content: space-between; }
  }
  @media (max-width: 767px) and (min-width: 300px) and (min-height: 520px) {
    /* The floating column under the header. It takes no taps of its own, so the map stays in reach beside
       its children, and it leaves room for the zoom buttons. */
    .map-controls { position: absolute; top: 3.75rem; left: .5rem; right: 3.5rem; z-index: 5; flex-direction: column; flex-wrap: nowrap; align-items: flex-start; gap: .5rem; padding: 0; pointer-events: none; }
    .map-controls > * { flex: none; pointer-events: auto; }
    .filters-toggle { display: flex; align-items: center; gap: .5rem; max-width: 100%; padding: .25rem .75rem; text-align: left; background-color: var(--surface); border-radius: var(--card-radius); box-shadow: var(--card-shadow); }
    .filters-toggle:hover:not(:disabled) { background-color: var(--surface); }
    .filters-toggle strong { flex: none; font-size: var(--text-14); }
    .filters-toggle span { font-size: var(--text-12); font-weight: 400; line-height: 1.25; color: var(--muted); }
    .map-notes { flex: none; padding: .25rem .5rem; background: var(--surface); border-radius: var(--card-radius); box-shadow: var(--card-shadow); }
    .view-controls { position: fixed; right: .5rem; bottom: calc(var(--sheet-height, 0px) + 2rem); z-index: 7; padding: .25rem; background: var(--surface); border-radius: var(--card-radius); box-shadow: var(--card-shadow); }
    .view-controls button { min-width: 3.5rem; padding-inline: .5rem; font-size: var(--text-14); }
    /* With a municipality selected, the panel carries the long caveat of the prostate. */
    :global(.home:has(#municipality-preview[data-enhanced]:not([hidden]))) #indicator-caveat[data-in-panel] { display: none; }
    :global(.home:has(#municipality-preview[data-enhanced]:not([hidden]))) .map-notes:has(#indicator-caveat[data-in-panel]):has(#map-selection-notice[hidden]) { display: none; }
    /* In the list the column enters the flow, above the rows it would otherwise cover. */
    :global(.home:has(.indicator-table:not([hidden]))) .map-controls { position: relative; top: auto; left: auto; right: auto; padding: 3.75rem .5rem 0; pointer-events: auto; }
  }
  @media (min-width: 768px) {
    .map-controls { position: relative; z-index: 6; flex: none; align-items: center; gap: .5rem 1.25rem; min-height: 56px; padding: .25rem 1rem; background: var(--surface); border-bottom: 1px solid var(--border); }
    label, .cancer-type { flex: 0 1 auto; flex-direction: row; align-items: center; gap: .5rem; white-space: nowrap; }
    .cancer-type-heading { flex: none; }
    #map-indicator { width: 19rem; }
    #map-reading { width: 10rem; }
    #cancer-type { width: 11rem; }
    .view-controls { margin-left: auto; align-self: center; }
    /* Caveats hang under the bar, over the map's empty corner, so they never change the map's height.
       In the list view they enter the flow, where the rows would otherwise sit beneath them. */
    .map-notes { position: absolute; top: calc(100% + 1px); left: 0; max-width: min(18rem, calc(100% - 4rem)); padding: .5rem 1rem; background: var(--surface); border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); border-bottom-right-radius: var(--card-radius); }
    :global(.home:has(.indicator-table:not([hidden]))) .map-notes { position: static; max-width: none; padding: 0; border: 0; }
    :global(.home:has(#municipality-preview:not([hidden]))) .map-notes { max-width: min(18rem, calc(100% - var(--panel-width) - 4rem)); }
  }
</style>
