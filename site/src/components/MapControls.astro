---
import manifest from '../../public/dados/manifest.json';
import { CANCER_TYPES, DEFAULT_CANCER_TYPE, INDICATORS, cancerTypeNotes, mapOption } from "../map/indicator-layer";

// Controls become available once their data is ready.
const hpvPending = !Object.hasOwn(manifest.indicators, 'hpv');
const notes = cancerTypeNotes({ cancer_type: DEFAULT_CANCER_TYPE, has_status: true });
---

<form class="map-controls" aria-label="O que o mapa mostra" onsubmit="return false">
  <div class="municipality-search">
    <label for="municipality-search">Buscar município</label>
    <input id="municipality-search" type="search" placeholder="Nome do município e UF" aria-controls="municipality-results" disabled />
    <p id="search-status" role="status"></p>
    <ul id="municipality-results" aria-label="Municípios encontrados"></ul>
  </div>
  <div class="cancer-type">
    <label>
      Tipo de câncer
      <select id="cancer-type" name="cancer-type" aria-describedby="cancer-type-note" disabled>
        {
          Object.entries(CANCER_TYPES).map(([value, label]) => (
            <option value={value} selected={value === DEFAULT_CANCER_TYPE}>
              {label}
            </option>
          ))
        }
      </select>
    </label>
    <div id="cancer-type-note" class="note" aria-live="polite">
      {notes.map((note) => <p>{note}</p>)}
    </div>
  </div>
  <label>
    O que o mapa mostra
    <select id="map-mode" disabled>
      {Object.entries(INDICATORS).map(([id, text]) => (
        <optgroup label={text.name}>
          {([...new Set(Object.values(text.modes).flat())]).map((mode) => {
            const pending = id === 'hpv' && hpvPending;
            const option = mapOption(id, DEFAULT_CANCER_TYPE, mode, pending);
            return <option value={`${id}:${mode}`} data-pending={pending ? 'true' : undefined} disabled={option.disabled}>{option.label}</option>;
          })}
        </optgroup>
      ))}
    </select>
  </label>
  <p id="map-selection-notice" class="note" role="status" hidden></p>
</form>

<style>
  .map-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    padding: 0.75rem 0;
  }
  label,
  .cancer-type {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.875rem;
    flex: 1 1 14rem;
  }
  .cancer-type label {
    flex: none;
  }
  input,
  select {
    font: inherit;
    padding: 0.4rem 0.5rem;
  }
  select:focus-visible {
    outline: 2px solid #1f2933;
    outline-offset: 2px;
  }
  .note {
    color: #4b5563;
    font-size: 0.8125rem;
  }
  .note p {
    margin: 0;
  }
  .note p + p {
    margin-top: 0.25rem;
  }
</style>
