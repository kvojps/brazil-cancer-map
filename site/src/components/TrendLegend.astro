---
import ContextHelp from "./ContextHelp.astro";
import {
  HATCH_CSS,
  STATUS_STATES, STATUS_COLORS, STATUS_LABELS, STATUS_LEGEND, INSUFFICIENT_CSS,
  INDICATORS,
  QUALITY_WARNING,
  REGION_NOTE,
  TREND_LABELS,
  TREND_STATES,
  measuredCasesText,
  trendDescriptions,
  trendPeriodText,
  qualityPeriodText,
  trendSwatch,
  type Period,
} from "../map/indicator-layer";

interface Props {
  indicator: string;
  period: Period;
}

const { indicator, period } = Astro.props;
const descriptions = trendDescriptions(INDICATORS[indicator]!);
const provisional = period.provisional.join(" e ");
const measuredCases = measuredCasesText(period);
const qualityPeriod = qualityPeriodText(period);
---

<section class="legend" aria-label="Legenda da Tendência">
  <div class="trend-legend">
    <h2>Tendência {trendPeriodText(period)}</h2>
    <p>A cor mostra como o indicador mudou ao longo dos anos. Não é um ranking entre municípios.</p>
    <p class="legend-measured-cases">{measuredCases && `${measuredCases}.`}</p>
    <ul>
      {
        TREND_STATES.map((state) => (
          <li>
            <span class="swatch" style={`background: ${trendSwatch(state)}`} aria-hidden="true" />
            <ContextHelp id={`legend-${state}`} label={TREND_LABELS[state]}>
              <span data-trend-description={state}>{descriptions[state]}</span>
            </ContextHelp>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="status-legend" hidden>
    <h2>Situação em {period.latest}</h2>
    <p>{STATUS_LEGEND}</p>
    <p class="legend-reference">Referência: 100% — o que a lei garante.</p>
    <p class="legend-measured-cases">{measuredCases && `${measuredCases}.`}</p>
    <ul>
      {STATUS_STATES.map(state => (
        <li>
          <span class="swatch" style={`background: ${state === "insufficient" ? INSUFFICIENT_CSS : STATUS_COLORS[state]}`} aria-hidden="true" />
          <span><strong>{STATUS_LABELS[state]}</strong>: {{ reached: "100% ou mais da referência.", near: "de 80% a menos de 100% da referência.", far: "menos de 80% da referência.", insufficient: "poucos casos no município e na sua região para calcular a Situação." }[state]}</span>
        </li>
      ))}
    </ul>
  </div>
  {
    qualityPeriod && (
      <ul class="quality">
        <li>
          <span class="swatch" style={`background: ${HATCH_CSS}`} aria-hidden="true" />
          <details class="context-help">
            <summary>Hachura (faixa C) — {QUALITY_WARNING}</summary> Vale para todo o estado, com 35% ou mais
            dos casos de {qualityPeriod} sem informação de tratamento. As faixas A (até 15%) e B (acima de
            15% e abaixo de 35%) não têm hachura.
          </details>
        </li>
      </ul>
    )
  }
  <details class="context-help legend-method">
    <summary>Origem e período dos dados</summary>
    <p>{REGION_NOTE}</p>
  <p class="note">
    Anos de diagnóstico {period.first_year}–{period.last_year}. {provisional} ainda são provisórios e
    não entram na tendência.
  </p>
  </details>
</section>

<style>
  .quality[hidden] { display: none; }
  .legend {
    font-size: 0.875rem;
    padding: .75rem 1rem;
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  h2 {
    font-size: 1rem;
    margin: 0 0 0.25rem;
  }
  p {
    margin: 0.25rem 0;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: .4rem 1.2rem;
  }
  li {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .swatch {
    flex: none;
    width: 1rem;
    height: 1rem;
    border: 1px solid #6b7280;
    transform: translateY(0.15rem);
  }
  .note {
    color: var(--muted);
  }
</style>
