<!-- On a phone the search stays behind this icon. Without JavaScript the search cannot run, so the link leads to the list by UF. -->
<a class="search-toggle" href="/municipios/" aria-label="Buscar município">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
</a>
<div class="municipality-search" role="search">
  <label for="municipality-search">Buscar município</label>
  <input id="municipality-search" type="search" placeholder="Nome do município e UF" aria-controls="municipality-results" disabled />
  <button type="button" class="search-close" aria-label="Fechar a busca"><span aria-hidden="true">×</span></button>
  <!-- For screen readers only, at every width: selecting must not reshape the bars. An empty search says so in the list. -->
  <p id="search-status" class="visually-hidden" role="status"></p>
  <ul id="municipality-results" aria-label="Municípios encontrados"></ul>
</div>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLAnchorElement>('.search-toggle');
  const input = document.querySelector<HTMLInputElement>('#municipality-search');
  if (header && toggle && input) {
    const close = () => { delete header.dataset.searchOpen; };
    const closeAndReturn = () => { close(); toggle.focus(); };
    toggle.addEventListener('click', event => {
      event.preventDefault();
      header.dataset.searchOpen = '';
      input.focus();
    });
    document.querySelector('.search-close')?.addEventListener('click', closeAndReturn);
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && 'searchOpen' in header.dataset) closeAndReturn(); });
    // Before the button acts: the panel waits behind the open search, and the selection takes focus to its name.
    document.querySelector('#municipality-results')?.addEventListener('click', event => {
      if (event.target instanceof Element && event.target.closest('button')) close();
    }, { capture: true });
    window.addEventListener('municipality-map-select', close);
  }
</script>

<style>
  .search-toggle, .search-close { display: none; }
  .municipality-search { position: relative; display: flex; flex-direction: column; gap: .25rem; flex: 1 1 100%; min-width: 0; font-size: var(--text-14); }
  label { font-weight: 500; line-height: 1.5rem; }
  input { width: 100%; }
  #search-status { margin: 0; }
  #municipality-results:empty { display: none; }
  #municipality-results { margin: 0; padding-left: 1.25rem; max-height: 18rem; overflow: auto; }
  @media (max-width: 767px) {
    .municipality-search { padding: 0 .25rem .25rem; }
    #municipality-results { padding: 0; list-style: none; }
    #municipality-results :global(li:not(:has(button))) { padding: .5rem .75rem; }
    #municipality-results :global(button) { width: 100%; text-align: left; background-color: transparent; }
  }
  @media (max-width: 767px) and (min-width: 300px) and (min-height: 520px) {
    .search-toggle { display: grid; place-items: center; flex: none; width: var(--control-height); height: var(--control-height); color: var(--text); border-radius: var(--control-radius); }
    .municipality-search { display: none; position: absolute; inset: 0 0 auto; z-index: 1; padding: 0; background: var(--surface); border-radius: var(--control-radius); }
    :global(.site-header[data-search-open]) .municipality-search { display: block; }
    label { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    input { display: block; padding-right: var(--control-height); }
    input::-webkit-search-cancel-button { display: none; }
    .search-close, .search-close:hover:not(:disabled) { display: grid; place-items: center; position: absolute; top: 0; right: 0; width: var(--control-height); padding: 0; font-size: var(--text-24); background: transparent; }
    /* Short enough to stay above a virtual keyboard, which does not change the height of the page. */
    #municipality-results { position: absolute; top: calc(100% + .25rem); inset-inline: 0; max-height: 26dvh; background: var(--surface); border-radius: var(--card-radius); box-shadow: var(--card-shadow); }
    /* The button already opens the consultation, and each row stays one touch target above the keyboard. */
    #municipality-results :global(a:not(.search-result)) { display: none; }
  }
  @media (min-width: 768px) {
    .municipality-search { flex: 0 1 15rem; }
    label { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    /* Results float over the bars, and step aside while focus and pointer are elsewhere. */
    #municipality-results { position: absolute; top: calc(100% + .25rem); right: 0; z-index: 25; width: min(24rem, calc(100vw - 2rem)); padding: .5rem 1rem; list-style: none; background: var(--surface); border-radius: var(--card-radius); box-shadow: var(--card-shadow); }
    #municipality-results :global(li) { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .5rem; padding-block: .25rem; }
    .municipality-search:not(:focus-within):not(:hover) #municipality-results { display: none; }
  }
  /* Results on pages without the dashboard, where each one is a link. */
  #municipality-results :global(.search-result) { display: flex; flex: 1; align-items: center; min-height: 44px; padding-inline: .75rem; color: var(--text); text-decoration: none; }
  #municipality-results :global(.search-result:hover) { background: var(--soft); }
  /* Without JavaScript the field cannot work: on these pages the icon leads to the list by UF at every width. */
  :global(html:not([data-js]) body:not(:has(.home))) .municipality-search { display: none; }
  :global(html:not([data-js]) body:not(:has(.home))) .search-toggle { display: grid; place-items: center; flex: none; width: var(--control-height); height: var(--control-height); color: var(--text); border-radius: var(--control-radius); }
</style>
