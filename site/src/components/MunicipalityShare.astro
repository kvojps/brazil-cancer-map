---
const { class: className, ...attributes } = Astro.props;
---
<div class:list={['municipality-share', className]} {...attributes} data-municipality-share hidden>
  <button type="button">
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
      <path d="m8.6 10.5 6.8-4m-6.8 7 6.8 4"></path>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
    </svg>
    Compartilhar
  </button>
  <p role="status"></p>
  <input type="text" aria-label="Link da consulta municipal" size="18" readonly hidden />
</div>

<style>
  .municipality-share { display: flex; flex-wrap: wrap; align-items: center; column-gap: .25rem; min-width: 0; }
  button, button:hover:not(:disabled) {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-width: 44px;
    color: var(--link);
    background: transparent;
  }
  button:hover:not(:disabled) { text-decoration: underline; }
  svg { flex: none; }
  p { flex: 1 1 min-content; margin: 0; color: var(--muted); font-size: var(--text-14); }
  p:empty { position: absolute; }
  input { display: block; width: 100%; margin-block: 8px; }
</style>
