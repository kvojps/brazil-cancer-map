---
import '../profile/profile.css';
import IndicatorTable from './IndicatorTable.astro';
import MapControls from './MapControls.astro';
import MunicipalityMap from './MunicipalityMap.astro';
import TrendLegend from './TrendLegend.astro';
import manifest from '../../public/dados/manifest.json';
interface Props { selected?: boolean }
const { selected = false } = Astro.props;
const indicator = 'within_60_days';
const period = manifest.indicators[indicator].all;
---
<div class="home">
  <h1 class="visually-hidden">Mapa do câncer no Brasil</h1>
  <MapControls />
  <div class="map-and-profile">
    <div class="map-with-legend">
      <header class="map-heading">
        <span class="eyebrow">Panorama territorial · Brasil</span>
        <h2 id="map-indicator-heading">Tratamento em até 60 dias</h2>
      </header>
      <nav class="view-controls" aria-label="Visualização" hidden>
        <button type="button" data-view="mapa" aria-pressed="true">Mapa</button>
        <button type="button" data-view="lista" aria-pressed="false">Lista</button>
      </nav>
      <div data-map-view><MunicipalityMap /><TrendLegend indicator={indicator} period={period} /></div>
      <IndicatorTable />

    </div>
    <aside hidden={!selected} id="municipality-preview" aria-labelledby="preview-heading">
      <h2 id="preview-heading" tabindex="-1">Meu município</h2>
      <p data-profile-summary role="status"></p>
      <div class="panel-actions">
        <button type="button" data-toggle-profile aria-expanded="false" aria-controls="municipality-content" hidden>Expandir consulta</button>
        <button type="button" data-collapse-profile hidden>Voltar ao mapa</button>
        <button type="button" data-clear-profile hidden>Limpar seleção</button>
      </div>
      <div id="municipality-content" data-preview-content><slot /></div>
    </aside>
    <button type="button" data-reopen-profile hidden>Reabrir Meu município</button>
  </div>
  <div class="data-feedback">
    <p id="data-status" role="status">Use a busca para encontrar seu município ou consulte a lista por UF.</p>
    <button id="retry-data" type="button" hidden>Tentar novamente</button>
  </div>
</div>
<style>
  .home { display: flex; flex-direction: column; gap: 1rem; min-height: 85vh; }
  .map-and-profile { display: grid; grid-template-columns: minmax(0, 1fr); align-items: stretch; gap: 1rem; }
  .map-and-profile:has(#municipality-preview:not([hidden])) { grid-template-columns: minmax(0, 1fr) minmax(20rem, 32rem); }
  .map-with-legend { min-width: 0; border-radius: var(--card-radius); overflow: clip; }
  .view-controls { padding: .5rem 1rem; display: flex; gap: .5rem; }
  .view-controls[hidden] { display: none; }
  .map-heading { padding: 1rem 1rem 0; }
  .map-heading h2 { margin: .25rem 0; }
  .eyebrow { font-size: var(--text-14); font-weight: 500; color: var(--muted); }
  #municipality-preview { min-width: 0; padding: 1rem; border-radius: var(--card-radius); background: var(--surface); }
  #municipality-preview h2 { margin-top: 0; }
  #municipality-preview :global(.warning) { padding: .75rem; border-radius: var(--control-radius); background: var(--soft); }
  #municipality-preview :global(h3) { font-size: var(--text-16); }
  .panel-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-block: .75rem; }
  #municipality-preview { max-height: 85vh; overflow: auto; }
  #municipality-preview[data-collapsed] [data-preview-content] { display: none; }
  @media (min-width: 768px) {
    #municipality-preview { contain: size; min-height: 0; max-height: none; }
  }
  @media (max-width: 767px) {
    #municipality-preview[data-enhanced] { position: fixed; inset-inline: .5rem; bottom: .5rem; z-index: 2; max-height: 75vh; overscroll-behavior: contain; box-shadow: var(--card-shadow); }
    .map-and-profile:has(#municipality-preview:not([hidden])) { grid-template-columns: minmax(0, 1fr); }
  }
</style>
