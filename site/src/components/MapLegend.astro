---
import TrendLegend from './TrendLegend.astro';
import {
  HATCH_CSS, STATUS_LABELS, STATUS_STATES,
  TREND_LABELS, TREND_STATES, qualityPeriodText, statusSwatch, trendPeriodText, trendSwatch, type Period,
} from '../map/indicator-layer';
import { CORNER_CAVEAT } from '../map/legend';

interface Props { indicator: string; period: Period }
const { indicator, period } = Astro.props;
const classes = {
  trend: TREND_STATES.map(state => ({ label: TREND_LABELS[state], swatch: trendSwatch(state) })),
  status: STATUS_STATES.map(state => ({ label: STATUS_LABELS[state], swatch: statusSwatch(state) })),
};
---
<!-- The map shows this summary and the full legend opens from ⓘ. -->
<section class="legend-corner" aria-label="Legenda do mapa">
  <p class="legend-corner-title">Tendência {trendPeriodText(period)}</p>
  <p class="legend-corner-caveat">{CORNER_CAVEAT.trend}</p>
  {Object.entries(classes).map(([mode, items]) => (
    <ul data-corner-mode={mode} hidden={mode !== 'trend'}>
      {items.map(item => <li><span class="swatch" style={`background: ${item.swatch}`} aria-hidden="true" />{item.label}</li>)}
      <li data-corner-quality hidden={!qualityPeriodText(period)}><span class="swatch" style={`background: ${HATCH_CSS}`} aria-hidden="true" />Faixa C</li>
    </ul>
  ))}
  <button type="button" class="legend-corner-more" popovertarget="legend-full" aria-label="Abrir a legenda completa e as ressalvas">ⓘ</button>
</section>
<div id="legend-full" class="legend-full" popover>
  <TrendLegend indicator={indicator} period={period} />
  <button type="button" class="legend-full-close" popovertarget="legend-full" popovertargetaction="hide">Fechar legenda</button>
</div>

<style>
  .legend-corner { position: relative; padding: .5rem .75rem .75rem; font-size: var(--text-14); line-height: 1.3; background: var(--surface); }
  .legend-corner[hidden] { display: none; }
  .legend-corner-title { margin: 0; padding-right: 2.25rem; font-weight: 600; }
  .legend-corner-caveat { margin: 0 0 .25rem; font-size: var(--text-12); color: var(--muted); }
  ul { display: flex; flex-direction: column; gap: .25rem; margin: .25rem 0 0; padding: 0; list-style: none; }
  li { display: flex; align-items: center; gap: .5rem; }
  .swatch { flex: none; width: .875rem; height: .875rem; border: 1px solid var(--swatch-border); }
  .legend-corner-more, .legend-corner-more:hover:not(:disabled) { position: absolute; top: 0; right: 0; width: var(--control-height); padding: 0; font-size: var(--text-16); color: var(--muted); background: transparent; }
  .legend-full:popover-open { width: min(32rem, calc(100vw - 2rem)); max-height: 80dvh; overflow: auto; padding: 0 0 .75rem; color: var(--text); background: var(--surface); border: 0; border-radius: var(--card-radius); box-shadow: var(--card-shadow); }
  .legend-full::backdrop { background: var(--backdrop); }
  .legend-full-close { display: block; margin-left: 1rem; }
  @media (min-width: 768px) {
    .legend-corner { position: absolute; left: 0; bottom: 0; z-index: 3; width: 13.5rem; max-height: 100%; overflow: auto; border-top: 1px solid var(--border); border-right: 1px solid var(--border); border-top-right-radius: var(--card-radius); }
    /* With a municipality selected, the panel beside the map already explains the result. */
    :global(.map-and-profile:has(#municipality-preview:not([hidden]))) .legend-corner-caveat { display: none; }
  }
  @media (max-width: 767px) and (min-width: 300px) and (min-height: 520px) {
    /* The ⓘ holds the reading of the color and every caveat: the card keeps only period and classes. */
    .legend-corner { position: absolute; left: .5rem; bottom: .5rem; z-index: 3; width: 11rem; max-width: calc(100% - 1rem); padding: .25rem .5rem .5rem; font-size: var(--text-12); border-radius: var(--card-radius); box-shadow: var(--card-shadow); }
    .legend-corner-title { padding-right: 1.75rem; }
    .legend-corner-caveat { display: none; }
    ul { gap: 0; line-height: 1.5; }
    .swatch { width: .75rem; height: .75rem; }
    /* The panel covers this corner on a phone, and its own Legenda button opens the full legend. */
    :global(.map-and-profile:has(#municipality-preview[data-enhanced]:not([hidden]))) .legend-corner { display: none; }
  }
  /* Clear of the map's attribution on the narrowest floating screens. */
  @media (max-width: 339px) and (min-width: 300px) and (min-height: 520px) {
    .legend-corner { width: 10.5rem; }
  }
</style>
