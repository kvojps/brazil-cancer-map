---
import Base from '../layouts/Base.astro';
import HeaderSearch from '../components/HeaderSearch.astro';
import MunicipalityIndex from '../components/MunicipalityIndex.astro';
---
<Base title="Municípios por UF | Observatório do Câncer no Brasil">
  <HeaderSearch slot="header-tools" />
  <div class="directory">
    <header>
      <h1 id="municipality-index-heading">Encontre seu município</h1>
      <p>Abra uma UF e escolha um município para consultar os indicadores e as orientações de cuidado com o câncer.</p>
    </header>
    <MunicipalityIndex />
  </div>
</Base>
<style>
  .directory { max-width: 64rem; margin: 0 auto; padding-block: .5rem 3rem; }
  header { margin-block: 0 1.5rem; max-width: 42rem; }
  h1 { margin-block: 0 .5rem; }
  header p { margin: 0; color: var(--muted); }
</style>
