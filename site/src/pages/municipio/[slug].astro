---
import { readFileSync } from 'node:fs';
import { publicDir } from 'astro:config/server';
import Base from '../../layouts/Base.astro';
import '../../profile/profile.css';
import MapExperience from '../../components/MapExperience.astro';
import MunicipalityProfile from '../../components/MunicipalityProfile.astro';
import MunicipalitySearch from '../../components/MunicipalitySearch.astro';
import listing from '../../../public/dados/municipalities.json';
import { municipalityPath, type UfProfile } from '../../profile/profile';

export function getStaticPaths() {
  // Read data directly: Vite's dev JSON transformation exceeds the Node heap.
  // Share each parsed UF across its municipalities instead of parsing per page.
  const profiles = new Map<string, UfProfile>();
  return listing.municipalities.map(municipality => {
    let profile = profiles.get(municipality.uf);
    if (!profile) {
      profile = JSON.parse(readFileSync(new URL(`dados/profiles/${municipality.uf}.json`, publicDir), 'utf8')) as UfProfile;
      profiles.set(municipality.uf, profile);
    }
    return { params: { slug: municipalityPath(municipality).split('/')[2] }, props: { municipality, profile } };
  });
}
interface Props {
  municipality: typeof listing.municipalities[number];
  profile: UfProfile;
}
const { municipality, profile } = Astro.props;
---
<Base title={`${municipality.name} (${municipality.uf}) — Meu município`}>
  <MunicipalitySearch slot="header-tools" />
  <MapExperience selected heading={`${municipality.name} (${municipality.uf})`}><MunicipalityProfile municipality={municipality} profile={profile} /></MapExperience>
</Base>
