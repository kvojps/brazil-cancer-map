---
import Base from '../../layouts/Base.astro';
import '../../profile/profile.css';
import MunicipalityProfile from '../../components/MunicipalityProfile.astro';
import listing from '../../../public/dados/municipalities.json';
import { municipalityPath, type UfProfile } from '../../profile/profile';

export function getStaticPaths() {
  const profiles = import.meta.glob('../../../public/dados/profiles/*.json', { eager: true, import: 'default' });
  return listing.municipalities.map(municipality => {
    const profile = profiles[`../../../public/dados/profiles/${municipality.uf}.json`] as UfProfile | undefined;
    if (!profile) throw new Error(`Missing municipality profile for ${municipality.uf}; run the pipeline export.`);
    return { params: { slug: municipalityPath(municipality).split('/')[2] }, props: { municipality, profile } };
  });
}
interface Props {
  municipality: typeof listing.municipalities[number];
  profile: UfProfile;
}
const { municipality, profile } = Astro.props;
---
<Base title={`${municipality.name} (${municipality.uf}) — Meu município`}>
  <MunicipalityProfile municipality={municipality} profile={profile} />
  <script>
    import { readMapState } from '../../map/map-state';
    const showType = () => {
      const type = readMapState(new URLSearchParams(location.search)).cancerType;
      for (const section of document.querySelectorAll<HTMLElement>('[data-cancer-type]')) section.hidden = section.dataset.cancerType !== type;
    };
    showType();
    window.addEventListener('popstate', showType);
  </script>
</Base>
